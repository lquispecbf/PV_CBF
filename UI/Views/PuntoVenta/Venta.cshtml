@{
    ViewData["Title"] = "Punto de Venta";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2 class="titulo-pagina">
            @ViewData["Title"]
        </h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="../Seguridad/Principal">Principal</a>
            </li>
            <li class="breadcrumb-item">
                <a>Punto de Venta</a>
            </li>
            <li class="breadcrumb-item active">
                <strong>Venta</strong>
            </li>
        </ol>
    </div>
</div>


<div class="row">
    <div class="col-lg-12">
        <div class="tabs-container">
            <ul class="nav nav-tabs tabs-pv">
                <li class="nav-item">
                    <a class="nav-link pl-2 pr-2 active" data-pv-tab="main" href="#tab-1"> <i class="fas fa-search mr-1"></i> BÚSQUEDA</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link pl-2 pr-2" data-pv-tab="main" href="#tab-2"><i class="fas fa-shopping-cart mr-1"></i>VENTA</a>
                </li>
            </ul>
            <div class="tab-content">
                <!-- TAB BUSQUEDA -->
                <div id="tab-1" class="tab-pane active show">
                    <div class="panel-body">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="row mb-2 filtros-busqueda align-items-end">

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 col-xl-2 mb-2">
                                            <label> Búsqueda:</label>
                                            <div class="input-group input-group-sm input-clear">
                                                <input type="text"
                                                       class="form-control"
                                                       id="txtBusquedaClienteDocumento"
                                                       placeholder="Cliente o DNI/RUC..."
                                                       autocomplete="off" />
                                                <div class="input-group-append">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-clear-input"
                                                            title="Limpiar"
                                                            tabindex="-1"
                                                            aria-label="Limpiar búsqueda">
                                                        <i class="fa fa-times" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 col-xl-2 mb-2">
                                            <label>Vendedor:</label>
                                            <select class="form-control form-control-sm" id="ddlBusquedaVendedor">
                                                <option value=""><< Seleccionar >></option>
                                            </select>
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 col-xl-2 mb-2">
                                            <label>Fecha Inicio:</label>
                                            <input type="text"
                                                   class="form-control form-control-sm input-fecha"
                                                   id="txtBusquedaFechaInicio"
                                                   autocomplete="off" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 col-xl-2 mb-2">
                                            <label>Fecha Fin:</label>
                                            <input type="text"
                                                   class="form-control form-control-sm input-fecha"
                                                   id="txtBusquedaFechaFin"
                                                   autocomplete="off" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-1 col-xl-2 mb-2">
                                            <button id="btnBusquedaBuscar"
                                                    type="button"
                                                    class="btn btn-sm w-100 btn-custom btn-buscar-tab"
                                                    style="height: calc(1.8125rem + 2px);"
                                                    title="Buscar">
                                                <i class="fa fa-magnifying-glass"></i><span class="d-inline d-lg-none d-xl-inline"> Buscar</span>
                                            </button>
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-6 col-lg-1 col-xl-2 mb-2">
                                            <button id="btnBusquedaExportar"
                                                    type="button"
                                                    class="btn btn-sm w-100"
                                                    style="background-color:#f3af5e;color:#fff;border-color:#f3af5e;height: calc(1.8125rem + 2px);"
                                                    title="Exportar Excel (F6)">
                                                <i class="fa fa-file-excel"></i><span class="d-inline d-lg-none d-xl-inline"> Exportar (F6)</span>
                                            </button>
                                        </div>

                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-2">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <span class="text-muted small" id="lblBusquedaAccionesHint">Seleccione un registro para habilitar las acciones</span>
                                        <div class="d-flex flex-wrap">
                                            <button id="btnBusquedaImprimir"
                                                    type="button"
                                                    class="btn btn-sm btn-custom mr-2"
                                                    style="background-color:#6c757d;color:#fff;border-color:#6c757d;"
                                                    disabled
                                                    title="Imprimir el pedido seleccionado (F7)">
                                                <i class="fa fa-print"></i> Imprimir <small>(F7)</small>
                                            </button>
                                            <button id="btnBusquedaEnviarWms"
                                                    type="button"
                                                    class="btn btn-sm btn-custom mr-2"
                                                    style="background-color:#1ab394;color:#fff;border-color:#1ab394;"
                                                    disabled
                                                    title="Enviar el documento a WMS (F8)">
                                                <i class="fa fa-paper-plane"></i> Enviar WMS <small>(F8)</small>
                                            </button>
                                            <div class="btn-group mr-2">
                                                <button id="btnBusquedaAcciones"
                                                        type="button"
                                                        class="btn btn-sm btn-custom dropdown-toggle"
                                                        data-toggle="dropdown"
                                                        aria-haspopup="true"
                                                        aria-expanded="false"
                                                        disabled
                                                        title="Acciones del pedido seleccionado (F9)">
                                                    <i class="fa fa-cog"></i> Acciones <small>(F9)</small>
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right">
                                                    <a class="dropdown-item" href="#" data-accion="preliminar-sap" title="Preliminar SAP (F10)">Preliminar SAP <small class="text-muted float-right">(F10)</small></a>
                                                    <a class="dropdown-item" href="#" data-accion="preliminar-pv" title="Preliminar PV (F11)">Preliminar PV <small class="text-muted float-right">(F11)</small></a>
                                                    <a class="dropdown-item" href="#" data-accion="ticket" title="Ticket (F12)">Ticket <small class="text-muted float-right">(F12)</small></a>
                                                    <div class="dropdown-divider"></div>
                                                    <a class="dropdown-item" href="#" data-accion="enviar-sap">Enviar SAP</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="row" style="overflow-x: auto;">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table id="tblBusquedaVentas" class="table table-hover table-striped compact" style="display:none">
                                                    <thead>
                                                        <tr>
                                                            <th>VER</th>
                                                            <th>ANULAR</th>
                                                            <th>REABRIR</th>
                                                            <th>COND. PAGO</th>
                                                            <th class="th-col-cliente">
                                                                CLIENTE
                                                                <span class="col-resizer" title="Arrastrar para ajustar ancho (Doble clic para restablecer)"></span>
                                                            </th>
                                                            <th>RUC/DNI</th>
                                                            <th>FECHA</th>
                                                            <th class="th-col-vendedor">
                                                                VENDEDOR
                                                                <span class="col-resizer" title="Arrastrar para ajustar ancho (Doble clic para restablecer)"></span>
                                                            </th>
                                                            <th>ALMACEN</th>
                                                            <th class="th-col-comentario">
                                                                COMENTARIO
                                                                <span class="col-resizer" title="Arrastrar para ajustar ancho (Doble clic para restablecer)"></span>
                                                            </th>
                                                            <th>LUGAR ENTREGA</th>
                                                            <th>TOTAL</th>
                                                            <th>NROSAP</th>
                                                            <th>ESTADO ENVIO</th>
                                                            <th>USUARIO MODIFICA</th>
                                                            <th>FECHA Y HORA</th>
                                                            <th>PC</th>
                                                            <th>DOCENTRY</th>
                                                            <th>DOCSTATUS</th>
                                                            <th>DOCENTRY_SAP</th>
                                                            <th>DOCENTRY_OWTR</th>
                                                            <th>LOG</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB VENTA -->
                <div id="tab-2" class="tab-pane">
                    <div class="panel-body">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
                            <div class="d-flex align-items-center flex-wrap">
                                <ul class="nav nav-pills mb-0 nav-pills-pv">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-pv-tab="sub" href="#tab-cliente" title="Ctrl+1">    <i class="fas fa-user mr-1"></i>Cliente <small style="color:inherit;">(Ctrl+1)</small></a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-pv-tab="sub" href="#tab-logistica" title="Ctrl+2">   <i class="fas fa-truck mr-1"></i>Logística <small style="color:inherit;">(Ctrl+2)</small></a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-pv-tab="sub" href="#tab-financiero" title="Ctrl+3"> <i class="fas fa-dollar-sign mr-1"></i>Financiero <small style="color:inherit;">(Ctrl+3)</small></a>
                                    </li>
                                </ul>
                                <small id="lblAutoSaveStatus" class="ml-3 font-italic" style="font-size:0.8rem;"></small>
                            </div>
                            <div class="row mt-1">
                                <div class="col-12 col-sm-6 col-md-6 col-lg mb-1">
                                    <button id="btnBorradoresLocales" type="button" class="btn btn-sm btn-custom btn-block" style="background-color:#17a2b8;color:#fff;border-color:#17a2b8;" title="Ver ventas guardadas localmente en este navegador">
                                        <i class="fa fa-folder-open"></i> Borradores <span id="badgeBorradoresCount" class="badge badge-light" style="display:none;margin-left:2px;">0</span>
                                    </button>
                                </div>
                                <div class="col-12 col-sm-6 col-md-6 col-lg mb-1">
                                    <button id="btnVentaLimpiar" class="btn btn-sm btn-custom btn-block" style="background-color:#f3af5e;color:#fff;border-color:#f3af5e;" title="Limpiar (F9)">
                                        <i class="fa fa-eraser"></i> Limpiar <small style="color:inherit;">(F9)</small>
                                    </button>
                                </div>
                                <div class="col-12 col-sm-6 col-md-6 col-lg mb-1">
                                    <button id="btnVentaGuardar" class="btn btn-success btn-sm btn-custom btn-block" title="Guardar Venta (F10)">
                                        <i class="fa fa-save"></i> Guardar Venta <small style="color:inherit;">(F10)</small>
                                    </button>
                                </div>
                                <div class="col-12 col-sm-6 col-md-6 col-lg mb-1">
                                    <button id="btnVentaBorrador" class="btn btn-sm btn-custom btn-block" style="background-color:#6c757d;color:#fff;border-color:#6c757d;" title="Guardar Borrador (F11)">
                                        <i class="fa fa-save"></i> Guardar Borrador <small style="color:inherit;">(F11)</small>
                                    </button>
                                </div>
                                <div class="col-12 col-sm-6 col-md-6 col-lg mb-1">
                                    <button id="btnVentaImportarArticulo" class="btn btn-sm btn-custom btn-block" style="background-color:#5dade2;color:#fff;border-color:#5dade2;" title="Importar Articulo (F12)">
                                        <i class="fa fa-file-excel"></i> Importar Articulo <small style="color:inherit;">(F12)</small>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="hdfUsuarioSapCode" value="@ViewBag.UsuarioSapCode" />
                        <input type="hidden" id="hdfDocEntry" value="" />
                        <input type="hidden" id="hdfDocEntrySap" value="" />
                        <input type="hidden" id="hdfDocStatusOriginal" value="" />

                        <div class="tab-content mb-0">

                            <div id="tab-cliente" class="tab-pane active show">
                                <div class="card mb-2 p-2">
                                    <div class="row compact-form">

                                        <div class="col-md-4 col-lg-3 col-xl-2">
                                            <label>Código</label>
                                            <input type="text" id="txtClienteCodigo" class="form-control form-control-sm" readonly />
                                        </div>

                                        <div class="col-md-8 col-lg-6 col-xl-4">
                                            <label>Cliente</label>
                                            <div class="input-group input-group-sm input-clear">
                                                <input type="text"
                                                       id="txtClienteNombre"
                                                       class="form-control form-control-sm autocomplete-cliente"
                                                       placeholder="Buscar cliente..."
                                                       data-tipo="cliente"
                                                       autocomplete="off" />
                                                <div class="input-group-append">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-clear-input"
                                                            title="Limpiar"
                                                            aria-label="Limpiar cliente"
                                                            tabindex="-1"
                                                            data-clear-targets="#txtClienteNombre,#txtClienteRuc,#txtClienteCodigo,#txtVentaLimiteCredito,#ddlClienteDireccionEnvioId,#txtClienteDireccionEnvio,#ddlClienteDireccionFacturaId,#txtClienteDireccionFactura">
                                                        <i class="fa fa-times" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6 col-lg-3 col-xl-2">
                                            <label>DNI/RUC</label>
                                            <div class="input-group input-group-sm input-clear">
                                                <input type="text"
                                                       id="txtClienteRuc"
                                                       class="form-control form-control-sm autocomplete-cliente"
                                                       placeholder="Buscar RUC/DNI..."
                                                       data-tipo="ruc"
                                                       autocomplete="off" />
                                                <div class="input-group-append">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-clear-input"
                                                            title="Limpiar"
                                                            aria-label="Limpiar RUC o DNI"
                                                            tabindex="-1"
                                                            data-clear-targets="#txtClienteNombre,#txtClienteRuc,#txtClienteCodigo,#txtVentaLimiteCredito,#ddlClienteDireccionEnvioId,#txtClienteDireccionEnvio,#ddlClienteDireccionFacturaId,#txtClienteDireccionFactura">
                                                        <i class="fa fa-times" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6 col-lg-4 col-xl-2">
                                            <label>Lista P.</label>
                                            <select id="ddlClienteListaPrecio" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-md-12 col-lg-8 col-xl-2">
                                            <label>Vendedor</label>
                                            <select id="ddlVentaVendedor" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-md-6 col-lg-6 col-xl-2">
                                            <label>Almacén</label>
                                            <select id="ddlVentaAlmacen" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-md-6 col-lg-6 col-xl-2">
                                            <label>Fecha Atención</label>
                                            <input type="text" id="txtVentaFechaAtencion" class="form-control form-control-sm input-fecha" />
                                        </div>

                                    </div>

                                    <div class="row compact-form align-items-end">

                                        <div class="col-md-3 col-lg-3 col-xl-2">
                                            <label>Id Dir. Envío</label>
                                            <select id="ddlClienteDireccionEnvioId" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-md-9 col-lg-9 col-xl-4">
                                            <label>Dirección Envío</label>
                                            <input type="text" id="txtClienteDireccionEnvio" class="form-control form-control-sm" readonly tabindex="-1" />
                                        </div>

                                        <div class="col-md-3 col-lg-3 col-xl-2">
                                            <label>Id Dir. Factura</label>
                                            <select id="ddlClienteDireccionFacturaId" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-md-9 col-lg-9 col-xl-4">
                                            <label>Dirección Factura</label>
                                            <input type="text" id="txtClienteDireccionFactura" class="form-control form-control-sm" readonly tabindex="-1" />
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div id="tab-logistica" class="tab-pane">
                                <div class="card mb-2 p-2">
                                    <div class="row compact-form">

                                        <div class="col-12 col-sm-6 col-lg-2">
                                            <label>Tipo Embalaje</label>
                                            <select id="ddlLogisticaTipoEmbalaje" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label>Lugar Entrega</label>
                                            <select id="ddlLogisticaLugarEntrega" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-12 col-sm-12 col-lg-2">
                                            <label>Fecha Entrega</label>
                                            <input id="txtLogisticaFechaEntrega" class="form-control form-control-sm input-fecha" autocomplete="off" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-2">
                                            <label>Hora Entrega</label>
                                            <select id="ddlLogisticaHoraEntrega" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label>Modo Envío</label>
                                            <select id="ddlLogisticaModoEnvio" class="form-control form-control-sm"></select>
                                        </div>

                                    </div>

                                    <div class="row compact-form">

                                        <div class="col-12 col-sm-6 col-lg-2">
                                            <label>Agencia</label>
                                            <input id="txtLogisticaAgencia" class="form-control form-control-sm" autocomplete="off" maxlength="150" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-2">
                                            <label>DNI/RUC</label>
                                            <input id="txtLogisticaRuc" class="form-control form-control-sm" autocomplete="off" maxlength="25" inputmode="numeric" />
                                        </div>

                                        <div class="col-12 col-sm-12 col-lg-3">
                                            <label>Nombre Completo</label>
                                            <input id="txtLogisticaContactoNombre" class="form-control form-control-sm" autocomplete="off" maxlength="50" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-2">
                                            <label>Teléfono</label>
                                            <input id="txtLogisticaTelefono" class="form-control form-control-sm" autocomplete="off" maxlength="20" inputmode="numeric" />
                                        </div>

                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label>Lugar Envío</label>
                                            <div class="input-group input-group-sm">
                                                <input id="txtLogisticaLugarEnvio" class="form-control" autocomplete="off" readonly maxlength="250" />
                                                <div class="input-group-append">
                                                    <button type="button" id="btnDesbloquearLugarEnvio" class="btn btn-outline-warning" title="Habilitar ingreso de lugar de envío" tabindex="-1">
                                                        <i class="fa fa-unlock-alt"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="row compact-form">

                                        <div class="col-12">
                                            <label>Comentarios</label>
                                            <input id="txtLogisticaComentarios" class="form-control form-control-sm" autocomplete="off" maxlength="254" />
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div id="tab-financiero" class="tab-pane">
                                <div class="card mb-2 p-2">
                                    <div class="row compact-form">

                                        <div class="col-lg-3">
                                            <label>Forma Pago</label>
                                            <select id="ddlFinancieroFormaPago" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-lg-3">
                                            <label>Tipo Comprobante</label>
                                            <select id="ddlFinancieroTipoComprobante" class="form-control form-control-sm"></select>
                                        </div>

                                        <div class="col-lg-6">
                                            <div class="d-flex align-items-center mb-1">
                                                <label class="mb-0">Notas Crédito aplicables NC</label>

                                                <button type="button"
                                                        id="btnActualizarNotasCredito"
                                                        class="btn btn-primary btn-xs ml-2">
                                                    <i class="fa fa-refresh"></i> Actualizar
                                                </button>
                                            </div>

                                            <div id="contenedorNotasCredito"
                                                 class="notas-credito-grid">
                                                <small class="text-muted">Seleccione un cliente para cargar notas de crédito.</small>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="card mb-2 p-1">
                            <div id="detalleScrollContainer">
                                <table id="tblVentaDetalle" class="table table-sm table-bordered table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:40px"></th>
                                            <th style="width:40px"></th>
                                            <th class="ordenar-col th-col-descripcion" data-col="2">
                                                Descripción
                                                <span class="col-resizer" title="Arrastrar para ajustar ancho (Doble clic para restablecer)"></span>
                                            </th>
                                            <th class="ordenar-col" data-col="3">Código</th>
                                            <th class="ordenar-col" data-col="4">
                                                Por Vender
                                                <button type="button" id="btnActualizarStockDetalle" class="btn btn-xs btn-outline-light ml-1" title="Actualizar Por Vender desde SAP" tabindex="-1" style="padding: 0px 4px; font-size: 10px; line-height: 1.4; vertical-align: middle; border-color: rgba(255,255,255,0.7); border-radius: 3px;">
                                                    <i class="fa fa-sync-alt"></i>
                                                </button>
                                            </th>
                                            <th class="ordenar-col" data-col="5">Cantidad</th>
                                            <th>UMD</th>
                                            <th class="ordenar-col" data-col="7">Precio</th>
                                            <th class="ordenar-col" data-col="8">Total</th>
                                            <th class="ordenar-col" data-col="9">F. Venc.</th>
                                            <th>Regalo</th>
                                            <th>DSC</th>
                                            <th style="width:40px"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card p-1">
                            <div class="row align-items-end">

                                <div class="col-12 col-sm-6 col-md-6 col-lg-4 col-xl-2">
                                    <label>Límite Crédito</label>
                                    <div class="input-group input-group-sm">
                                        <input id="txtVentaLimiteCredito" class="form-control text-right" readonly value="0.00" />
                                        <div class="input-group-append">
                                            <button type="button" id="btnDesgloseCredito" class="btn btn-outline-success" title="Ver desglose del límite de crédito" tabindex="-1" disabled>
                                                <i class="fa fa-info-circle"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

