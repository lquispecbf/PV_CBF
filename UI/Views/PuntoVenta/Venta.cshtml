        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

        #tblLotesProductos tr.lote-asignacion-multilote:hover td {
            background-color: #f5c6cb !important;
        }

        #tblLotesProductos tr.lote-asignacion-multilote td:first-child {
            border-left: 5px solid #dc3545 !important;
        }

    #tblLotesProductos tr.selected.lote-asignacion-parcial td {
        background-color: #ffd8a8 !important;
        font-weight: 600;
    }

    .custom-file-label::after {
        content: "Examinar" !important;
    }

    /* Modal de Búsqueda Avanzada: Ancho Máximo Disponible y Responsivo */
    #modalBusquedaAvanzada .modal-dialog {
        max-width: 98vw !important;
        width: 98vw !important;
        margin: 10px auto !important;
    }

    @@media (max-width: 768px) {
        #modalBusquedaAvanzada .modal-dialog {
            max-width: 99vw !important;
            width: 99vw !important;
            margin: 5px auto !important;
        }
    }

    /* Select2 container dentro del modal supera z-index del modal */
    #modalBusquedaAvanzada .select2-container {
        z-index: 2250 !important;
    }

    /* Dropdown Titular RS: ancho mínimo y texto en una sola línea */
    #modalBusquedaAvanzada .select2-dropdown {
        min-width: 400px;
    }

    #modalBusquedaAvanzada .select2-results__option {
        white-space: nowrap;
    }

    #modalBusquedaAvanzada .select2-results__option--highlighted {
        background-color: #1ab394 !important;
    }

    /* Awesome Bootstrap Checkbox en tabla búsqueda avanzada */
    #modalBusquedaAvanzada th .checkbox,
    #modalBusquedaAvanzada td .checkbox {
        margin-bottom: 0;
        padding-left: 20px;
    }

        #modalBusquedaAvanzada th .checkbox label,
        #modalBusquedaAvanzada td .checkbox label {
            height: 17px;
            line-height: 17px;
        }

    /* Por vender = 0: fondo rojo */
    .por-vender-cero,
    #tblVentaDetalle tbody tr td input.por-vender-cero {
        background-color: #ed5565 !important;
        color: #fff !important;
    }

    /* Por vender que varió/cambió al actualizar: fondo celeste llamativo, texto contrastado y borde distintivo */
    .por-vender-cambiado,
    #tblVentaDetalle tbody tr td input.por-vender-cambiado {
        background-color: #d1ecf1 !important;
        color: #0c5460 !important;
        border: 1.5px solid #17a2b8 !important;
        font-weight: bold !important;
        box-shadow: 0 0 5px rgba(23, 162, 184, 0.7) !important;
    }

    .por-vender-cambiado.por-vender-cero,
    #tblVentaDetalle tbody tr td input.por-vender-cambiado.por-vender-cero {
        background-color: #ed5565 !important;
        color: #fff !important;
        border: 2px solid #b71c1c !important;
        box-shadow: 0 0 6px rgba(237, 85, 101, 0.8) !important;
    }

    #tblVentaDetalle tbody tr td.td-por-vender-cambiado {
        background-color: #d1ecf1 !important;
    }

    /* Vencimiento próximo (< 1 año): fondo rojo */
    .txtDetalleVencimiento.vencimiento-proximo {
        background-color: #ed5565 !important;
        color: #fff !important;
        border-color: #ed5565 !important;
    }

    /* Artículo que ya no permite venta fraccionada (cargado en reapertura): fondo amarillo suave */
    .fila-error-fraccionado {
        background-color: #fdf2ce !important;
    }

        .fila-error-fraccionado td {
            border-top-color: #f0e0a0 !important;
        }

    /* Ordenar columnas detalle */
    .ordenar-col {
        cursor: pointer;
        user-select: none;
    }

        .ordenar-col:hover {
            text-decoration: underline;
        }

        .ordenar-col::after {
            content: " \f0dc";
            font-family: FontAwesome;
            font-size: 11px;
            opacity: 0.6;
            margin-left: 4px;
        }

        .ordenar-col.asc::after {
            content: " \f0de";
            opacity: 1;
        }

        .ordenar-col.desc::after {
            content: " \f0dd";
            opacity: 1;
        }
    /* Altura uniforme en controles de fila detalle */
    .fila-detalle .form-control,
    .fila-detalle .form-control-sm,
    .fila-detalle .input-group-sm .form-control,
    .fila-detalle .input-group-sm .btn,
    .fila-detalle .btn-sm {
        height: 31px !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        font-size: 0.8rem;
    }
    /* Alineación de cantidad: Select al centro, Input a la derecha */
    .txtDetalleCantidadSelect {
        text-align: center !important;
        text-align-last: center !important;
    }

    .txtDetalleCantidad {
        text-align: right !important;
    }
    /* Alerta de Línea de Crédito excedida: fondo rojo suave y texto rojo */
    .credito-excedido {
        background-color: #f8d7da !important;
        color: #721c24 !important;
        border-color: #f5c6cb !important;
        font-weight: bold !important;
    }
    /* Desactivar selección, arrastre y transiciones para conmutación instantánea y sin bloqueos de pestañas en Edge */
    .tabs-pv,
    .tabs-pv *,
    .nav-pills-pv,
    .nav-pills-pv * {
        user-select: none !important;
        -webkit-user-select: none !important;
        -ms-user-select: none !important;
        -webkit-user-drag: none !important;
    }

        .tabs-pv .nav-link,
        .nav-pills-pv .nav-link,
        .tabs-container .tab-pane,
        .tabs-container .tab-content {
            transition: none !important;
            animation: none !important;
        }

            .tabs-container .tab-pane:not(.active) {
                display: none !important;
                contain: strict !important;
            }
</style>
<!-- MODAL BORRADORES LOCALES (Multi-Pestaña y Recuperación Offline/Crash) -->
<div class="modal fade" id="modalBorradoresLocales" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#1ab394;color:white">
                <h5 class="modal-title"><i class="fa fa-folder-open mr-1"></i> Ventas Guardadas Localmente (Borradores Multi-Pestaña)</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div class="alert alert-info py-2 mb-0 flex-grow-1 mr-2" style="font-size:0.85rem;">
                        <i class="fa fa-info-circle mr-1"></i> Estos borradores están guardados de forma segura en tu navegador. Puedes restaurar cualquier venta en esta pestaña o eliminar los borradores seleccionados.
                    </div>
                    <div class="btn-group">
                        <button type="button" id="btnEliminarBorradoresSeleccionados" class="btn btn-sm btn-danger" disabled>
                            <i class="fa fa-trash mr-1"></i> Eliminar Seleccionados (<span id="lblCountSeleccionados">0</span>)
                        </button>
                        <button type="button" id="btnEliminarTodosBorradores" class="btn btn-sm btn-outline-danger">
                            <i class="fa fa-trash-alt mr-1"></i> Vaciar Todos
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="tblBorradoresLocales" class="table table-bordered table-hover table-striped mb-0">
                        <thead style="background-color:#1ab394;color:white;">
                            <tr>
                                <th style="width:35px;text-align:center;">
                                    <input type="checkbox" id="chkSeleccionarTodosBorradores" title="Seleccionar todos" />
                                </th>
                                <th style="width:40px;text-align:center;">#</th>
                                <th style="width:160px;">Última Edición</th>
                                <th>Cliente</th>
                                <th style="width:90px;text-align:center;">Artículos</th>
                                <th style="width:120px;text-align:right;">Monto Total</th>
                                <th style="width:140px;">Almacén</th>
                                <th style="width:140px;text-align:center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-times mr-1"></i> Cerrar</button>
            </div>
        </div>
    </div>
</div>

