<script>
    $(document).on("click", "#side-menu a[href]", function (e) {
        var href = $(this).attr("href");
        if (!href || href === "#" || href.indexOf("layouts.html") !== -1) return;
        if ($(this).hasClass("js-logout")) return;

        e.preventDefault();
        var destino = href;

        PV.confirmarNavegacion(function () {
            window.location.href = destino;
        });
    });

    $(window).on("beforeunload", function (e) {
        if (PV.cambiosPendientes) {
            e.returnValue = "";
            return "";
        }
    });
</script>

