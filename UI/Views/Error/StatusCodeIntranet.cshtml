@{
    Layout = "~/Views/Shared/MasterPage.cshtml";
    ViewData["Title"] = ViewBag.Title;
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-8 col-lg-offset-2">
            <div class="ibox">
                <div class="ibox-content text-center p-lg">

                    <h1 class="text-danger" style="font-size:80px; margin-bottom:10px;">
                        @ViewBag.Code
                    </h1>

                    <h2>@ViewBag.Title</h2>

                    <p class="m-t-md" style="font-size:16px;">
                        @ViewBag.Message
                    </p>

                    <div class="m-t-lg">
                        <a href="@Url.Action("Principal", "Seguridad")" class="btn btn-primary">
                            <i class="fa fa-home"></i> Ir al inicio
                        </a>

                        <button type="button" class="btn btn-default" onclick="history.back();">
                            <i class="fa fa-arrow-left"></i> Volver
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
